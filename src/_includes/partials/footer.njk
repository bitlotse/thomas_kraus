<footer class="site-footer">
  <div class="container site-footer__grid">
    <div>
      <p class="site-footer__brand">{{ client.brand.name }}</p>
      <p>{{ client.address.street }}<br>{{ client.address.postalCode }} {{ client.address.locality }}</p>
    </div>
    <div>
      <p class="site-footer__heading">Kontakt</p>
      <a href="tel:{{ client.contact.phoneInternational }}">{{ client.contact.phoneDisplay }}</a><br>
      <a href="mailto:{{ client.contact.email }}">{{ client.contact.email }}</a>
    </div>
    <nav aria-label="Rechtliches">
      <p class="site-footer__heading">Informationen</p>
      <ul>
        {% for item in navigation.legal %}<li><a href="{{ item.url }}">{{ item.label }}</a></li>{% endfor %}
      </ul>
    </nav>
  </div>
  <div class="container site-footer__meta">© {{ '' | currentYear }} {{ client.brand.name }} · Starter-Version 1.0.0</div>
</footer>
