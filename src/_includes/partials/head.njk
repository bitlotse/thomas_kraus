{% set pageTitle = title or site.defaultTitle %}
{% set pageDescription = description or site.defaultDescription %}
{% set canonicalUrl = canonical or (page.url | absoluteUrl(site.url)) %}
{% set socialImage = ogImage or site.defaultImage %}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ pageTitle }}{% if title %} | {{ titleSuffix or site.titleSuffix }}{% endif %}</title>
<meta name="description" content="{{ pageDescription }}">
<meta name="robots" content="{{ robots or site.robots }}">
<link rel="canonical" href="{{ canonicalUrl }}">
<meta property="og:type" content="website">
<meta property="og:locale" content="{{ site.locale }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ canonicalUrl }}">
<meta property="og:image" content="{{ socialImage | absoluteUrl(site.url) }}">
<meta name="theme-color" content="{{ site.themeColor }}">
<link rel="manifest" href="/site.webmanifest">
<link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/assets/css/tokens.css">
<link rel="stylesheet" href="/assets/css/global.css">
<link rel="stylesheet" href="/assets/css/components.css">
<link rel="stylesheet" href="/assets/css/pages.css">
<link rel="stylesheet" href="/assets/css/utilities.css">
{% if thHome %}<link rel="stylesheet" href="/assets/css/homepage.css">{% endif %}
<script type="application/ld+json">{{ (homeSchema or schema) | json | safe }}</script>
